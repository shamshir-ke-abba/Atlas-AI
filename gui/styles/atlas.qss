/*
    Atlas V3 Global Stylesheet
*/

/* =========================================================
   GLOBAL
   ========================================================= */

QMainWindow {
    background: #121212;
}

QWidget {
    background: transparent;
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 11pt;
}

QLabel {
    color: #FFFFFF;
}


/* =========================================================
   MAIN WINDOW
   ========================================================= */

#AtlasWindow {
    background: #121212;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#Sidebar {
    background: #181818;
    border-right: 1px solid #292929;
}

#AtlasLogo {
    color: #FFFFFF;
}

#HistoryTitle {
    color: #777777;
    font-size: 9pt;
    font-weight: bold;
}


/* =========================================================
   NEW CHAT
   ========================================================= */

#Sidebar QPushButton {
    background: #242424;
    color: #FFFFFF;

    border: 1px solid #303030;
    border-radius: 7px;

    padding: 9px 12px;
}

#Sidebar QPushButton:hover {
    background: #2D2D2D;
    border: 1px solid #3A3A3A;
}

#Sidebar QPushButton:pressed {
    background: #202020;
}


/* =========================================================
   HISTORY
   ========================================================= */

#HistoryList {
    background: #181818;
    border: none;
    outline: none;

    color: #DDDDDD;

    padding: 0px;
}

#HistoryList::item {
    background: transparent;

    padding: 8px 10px;
    margin: 2px 0px;

    border-radius: 6px;
}

#HistoryList::item:hover {
    background: #242424;
}

#HistoryList::item:selected {
    background: #2A2A2A;
    color: #FFFFFF;
}


/* =========================================================
   CHAT
   ========================================================= */

#Chat {
    background: #121212;
}

#ChatHeader {
    background: #121212;

    border-bottom: 1px solid #202020;
}

#ChatTitle {
    color: #FFFFFF;

    font-size: 18pt;
    font-weight: 600;
}

#ChatSubtitle {
    color: #777777;

    font-size: 9pt;
}

#MessagesContainer {
    background: #121212;
}

#ChatScroll {
    background: #121212;
    border: none;
}


/* =========================================================
   ATLAS MESSAGE
   ========================================================= */

#AtlasMessage {
    background: transparent;
}

#AtlasBubble {
    background: #1E1E1E;

    border: 1px solid #292929;
    border-radius: 12px;

    max-width: 700px;
}

#AtlasSender {
    color: #00BFFF;

    font-size: 9pt;
    font-weight: 600;
}

#AtlasMessageText {
    color: #EEEEEE;

    font-size: 11pt;
}


/* =========================================================
   USER MESSAGE
   ========================================================= */

#UserMessage {
    background: transparent;
}

#UserBubble {
    background: #252525;

    border: 1px solid #303030;
    border-radius: 12px;

    max-width: 700px;
}

#UserSender {
    color: #BBBBBB;

    font-size: 9pt;
    font-weight: 600;
}

#UserMessageText {
    color: #FFFFFF;

    font-size: 11pt;
}


/* =========================================================
   INPUT
   ========================================================= */

#InputBar {
    background: #121212;

    border-top: 1px solid #202020;
}

#InputField {
    background: #1E1E1E;

    color: #FFFFFF;

    border: 1px solid #303030;
    border-radius: 10px;

    padding: 10px 14px;

    selection-background-color: #0066CC;
}

#InputField:hover {
    border: 1px solid #3A3A3A;
}

#InputField:focus {
    border: 1px solid #00BFFF;
}


#SendButton {
    background: #0066CC;

    color: #FFFFFF;

    border: none;
    border-radius: 9px;

    padding: 10px 18px;

    font-weight: 600;
}

#SendButton:hover {
    background: #0077DD;
}

#SendButton:pressed {
    background: #0055AA;
}


/* =========================================================
   STATUS PANEL
   ========================================================= */

#StatusBar {
    background: #181818;

    border-left: 1px solid #292929;
}

#StatusTitle {
    color: #FFFFFF;

    font-size: 16pt;
    font-weight: 600;
}

#StatusText {
    color: #888888;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

QScrollBar:vertical {
    width: 8px;

    background: transparent;

    margin: 2px 0px 2px 0px;
}

QScrollBar::handle:vertical {
    background: #3A3A3A;

    border-radius: 4px;

    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* =========================================================
   HORIZONTAL SCROLLBAR
   ========================================================= */

QScrollBar:horizontal {
    height: 8px;

    background: transparent;
}

QScrollBar::handle:horizontal {
    background: #3A3A3A;

    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #555555;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}